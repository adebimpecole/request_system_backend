<div class="h-auto text-left">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-4 mb-4">
    <div class="">
      <div class="max-lg:hidden mb-6">
        <a
          class="inline-flex items-center gap-2 text-sm/6 text-zinc-500 -m-1"
          href="#"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
            data-slot="icon"
            class="size-4 fill-zinc-400"
          >
            <path
              fill-rule="evenodd"
              d="M9.78 4.22a.75.75 0 0 1 0 1.06L7.06 8l2.72 2.72a.75.75 0 1 1-1.06 1.06L5.47 8.53a.75.75 0 0 1 0-1.06l3.25-3.25a.75.75 0 0 1 1.06 0Z"
              clip-rule="evenodd"
            ></path>
          </svg>
          Orders
        </a>
      </div>
      <div class="flex items-center gap-4">
        <h1 class="text-2xl/8 font-semibold text-zinc-950 sm:text-xl/8">
          {{title}}
        </h1>
        <span
          class="inline-flex items-center gap-x-1.5 rounded-md px-1.5 py-0.5 text-sm/5 font-medium sm:text-xs/5 capitalize"
        >
          {{status}}
        </span>
      </div>
      <div
        class="isolate mt-2.5 flex flex-wrap justify-between gap-x-6 gap-y-4"
      >
        <div class="flex flex-wrap gap-x-10 gap-y-4 py-1.5">
          <span
            class="flex items-center gap-3 text-base/6 text-zinc-950 sm:text-sm/6"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              fill="currentColor"
              aria-hidden="true"
              data-slot="icon"
              class="size-4 shrink-0 fill-zinc-400"
            >
              <path
                fill-rule="evenodd"
                d="M1 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V3Zm9 3a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm-6.25-.75a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM11.5 6A.75.75 0 1 1 13 6a.75.75 0 0 1-1.5 0Z"
                clip-rule="evenodd"
              ></path>
              <path
                d="M13 11.75a.75.75 0 0 0-1.5 0v.179c0 .15-.138.28-.306.255A65.277 65.277 0 0 0 1.75 11.5a.75.75 0 0 0 0 1.5c3.135 0 6.215.228 9.227.668A1.764 1.764 0 0 0 13 11.928v-.178Z"
              >
              </path>
            </svg>
            <span>US${{amount}}.00</span>
          </span>
          <span
            class="flex items-center gap-3 text-base/6 text-zinc-950 sm:text-sm/6"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              fill="currentColor"
              aria-hidden="true"
              data-slot="icon"
              class="size-4 shrink-0 fill-zinc-400"
            >
              <path
                d="M2.5 3A1.5 1.5 0 0 0 1 4.5V5h14v-.5A1.5 1.5 0 0 0 13.5 3h-11Z"
              ></path>
              <path
                fill-rule="evenodd"
                d="M15 7H1v4.5A1.5 1.5 0 0 0 2.5 13h11a1.5 1.5 0 0 0 1.5-1.5V7ZM3 10.25a.75.75 0 0 1 .75-.75h.5a.75.75 0 0 1 0 1.5h-.5a.75.75 0 0 1-.75-.75Zm3.75-.75a.75.75 0 0 0 0 1.5h2.5a.75.75 0 0 0 0-1.5h-2.5Z"
                clip-rule="evenodd"
              ></path>
            </svg>
            <span class="inline-flex gap-3 capitalize">
              {{category}}
            </span>
          </span>
          <span
            class="flex items-center gap-3 text-base/6 text-zinc-950 sm:text-sm/6"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              fill="currentColor"
              aria-hidden="true"
              data-slot="icon"
              class="size-4 shrink-0 fill-zinc-400"
            >
              <path
                fill-rule="evenodd"
                d="M4 1.75a.75.75 0 0 1 1.5 0V3h5V1.75a.75.75 0 0 1 1.5 0V3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2V1.75ZM4.5 6a1 1 0 0 0-1 1v4.5a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1h-7Z"
                clip-rule="evenodd"
              ></path>
            </svg>
            <span>May 9, 2024</span>
          </span>
        </div>
        <div class="flex gap-4">
          <button
            class="text-red-600 bg-red-50 hover:bg-red-100 cursor-pointer text-sm/6 rounded-lg font-semibold px-3"
            type="button"
          >
            Reject
          </button>
          <button
            class="bg-green-50 hover:bg-green-100 text-green-500 text-sm/6 rounded-lg font-semibold px-3"
            type="button"
          >
            <span
              class="absolute left-1/2 top-1/2 size-[max(100%,2.75rem)] -translate-x-1/2 -translate-y-1/2 [@media(pointer:fine)]:hidden"
              aria-hidden="true"
            ></span>
            Approve
          </button>
        </div>
      </div>
    </div>
  </div>
  <div class="grid grid-cols-3 gap-4 mb-4 grid-rows-[auto_auto_auto]">
    <div class="col-span-2 mt-12 mr-16">
      <h2 class="text-base/7 font-semibold text-zinc-950 sm:text-sm/6 ">
        Description
      </h2>
      <div class="mt-4 text-sm">
        {{description}}
      </div>
    </div>
    <div class="mt-12 col-span-1 row-span-3 h-fit">
      <h2 class="text-base/7 font-semibold text-zinc-950 sm:text-sm/6 ">
        Progress
      </h2>
      <hr role="presentation" class="mt-4 w-full" />
      <ol class="relative text-gray-500 col-span-1 mt-4">
        <li class="mb-10 ms-6">
          <span
            class="absolute flex items-center justify-center w-6 h-6 bg-blue-200 rounded-full -start-4 ring-4 ring-white"
          >
            <svg
              class="w-3 h-3 text-blue-500"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 16 12"
            >
              <path
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M1 5.917 5.724 10.5 15 1.5"
              />
            </svg>
          </span>
          <h3 class="font-medium text-sm leading-tight">Personal Info</h3>
          <p class="text-xs">Step details here</p>
        </li>
        <li class="mb-10 ms-6">
          <span
            class="absolute flex items-center justify-center w-6 h-6 bg-gray-100 rounded-full -start-4 ring-4 ring-white"
          >
            <svg
              class="w-3 h-3 text-gray-500"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              fill="currentColor"
              viewBox="0 0 20 16"
            >
              <path
                d="M18 0H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2ZM6.5 3a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3.014 13.021l.157-.625A3.427 3.427 0 0 1 6.5 9.571a3.426 3.426 0 0 1 3.322 2.805l.159.622-6.967.023ZM16 12h-3a1 1 0 0 1 0-2h3a1 1 0 0 1 0 2Zm0-3h-3a1 1 0 1 1 0-2h3a1 1 0 1 1 0 2Zm0-3h-3a1 1 0 1 1 0-2h3a1 1 0 1 1 0 2Z"
              />
            </svg>
          </span>
          <h3 class="font-medium leading-tight text-sm">Account Info</h3>
          <p class="text-xs">Step details here</p>
        </li>
        <li class="mb-10 ms-6">
          <span
            class="absolute flex items-center justify-center w-6 h-6 bg-gray-100 rounded-full -start-4 ring-4 ring-white"
          >
            <svg
              class="w-3 h-3 text-gray-500"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              fill="currentColor"
              viewBox="0 0 18 20"
            >
              <path
                d="M16 1h-3.278A1.992 1.992 0 0 0 11 0H7a1.993 1.993 0 0 0-1.722 1H2a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2Zm-3 14H5a1 1 0 0 1 0-2h8a1 1 0 0 1 0 2Zm0-4H5a1 1 0 0 1 0-2h8a1 1 0 1 1 0 2Zm0-5H5a1 1 0 0 1 0-2h2V2h4v2h2a1 1 0 1 1 0 2Z"
              />
            </svg>
          </span>
          <h3 class="font-medium leading-tight text-sm">Review</h3>
          <p class="text-xs">Step details here</p>
        </li>
        <li class="ms-6">
          <span
            class="absolute flex items-center justify-center w-6 h-6 bg-gray-100 rounded-full -start-4 ring-4 ring-white"
          >
            <svg
              class="w-3 h-3 text-gray-500"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              fill="currentColor"
              viewBox="0 0 18 20"
            >
              <path
                d="M16 1h-3.278A1.992 1.992 0 0 0 11 0H7a1.993 1.993 0 0 0-1.722 1H2a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2ZM7 2h4v3H7V2Zm5.7 8.289-3.975 3.857a1 1 0 0 1-1.393 0L5.3 12.182a1.002 1.002 0 1 1 1.4-1.436l1.328 1.289 3.28-3.181a1 1 0 1 1 1.392 1.435Z"
              />
            </svg>
          </span>
          <h3 class="font-medium leading-tight text-sm">Confirmation</h3>
          <p class="text-xs">Step details here</p>
        </li>
      </ol>
    </div>

    <div class="mt-8 col-span-2 mr-16">
      <h2 class="text-base/7 font-semibold text-zinc-950 sm:text-sm/6">
        Summary
      </h2>
      <hr
        role="presentation"
        class="mt-4 w-full border-t border-zinc-950/10"
      />
      <dl
        class="grid grid-cols-1 text-base/6 sm:grid-cols-[min(50%,theme(spacing.80))_auto] sm:text-sm/6"
      >
        <dt
          class="col-start-1 border-t border-zinc-950/5 pt-3 text-zinc-500 first:border-none sm:border-t sm:border-zinc-950/5 sm:py-3 "
        >
          ID
        </dt>
        <dd
          class="pb-3 pt-1 text-zinc-950 sm:border-t sm:border-zinc-950/5 sm:py-3  sm:[&amp;:nth-child(2)]:border-none capitalize"
        >
          REQ
          {{requestid}}
        </dd>
        <dt
          class="col-start-1 border-t border-zinc-950/5 pt-3 text-zinc-500 first:border-none sm:border-t sm:border-zinc-950/5 sm:py-3"
        >
          Requester
        </dt>
        <dd
          class="pb-3 pt-1 text-zinc-950 sm:border-t sm:border-zinc-950/5 sm:py-3 sm:[&amp;:nth-child(2)]:border-none capitalize"
        >
          {{user}}
        </dd>
        <dt
          class="col-start-1 border-t border-zinc-950/5 pt-3 text-zinc-500 first:border-none sm:border-t sm:border-zinc-950/5 sm:py-3 "
        >
          Department
        </dt>
        <dd
          class="pb-3 pt-1 text-zinc-950 sm:border-t sm:border-zinc-950/5 sm:py-3 sm:[&amp;:nth-child(2)]:border-none capitalize"
        >
          {{department}}
        </dd>
      </dl>
    </div>
    <div></div>
    <div class="mr-16 col-span-2 mt-8">
      <h2 class="text-base/7 font-semibold text-zinc-950 sm:text-sm/6">
        Comments
      </h2>
      <div class="grid grid-cols-1 gap-4">
        <div
          class="pl-8 mt-4 relative before:absolute after:absolute before:bg-neutral-950 after:bg-neutral-950/10 before:left-0 before:top-0 before:h-6 before:w-px after:bottom-0 after:left-0 after:top-8 after:w-px"
        >
          <figure class="text-sm">
            <blockquote
              class="text-neutral-600 [&amp;>*]:relative [&amp;>:first-child]:before:absolute [&amp;>:first-child]:before:right-full [&amp;>:first-child]:before:content-['“'] [&amp;>:last-child]:after:content-['”']"
            >
              <p>
                Studio were so regular with their progress updates we almost
                began to think they were automated!
              </p>
            </blockquote>
            <figcaption class="mt-6 font-semibold text-neutral-950">
              Debra Fiscal, CEO of Unseal
            </figcaption>
          </figure>
        </div>
        <div
          class="pl-8 mt-8 relative before:absolute after:absolute before:bg-neutral-950 after:bg-neutral-950/10 before:left-0 before:top-0 before:h-6 before:w-px after:bottom-0 after:left-0 after:top-8 after:w-px"
        >
          <figure class="text-sm">
            <blockquote
              class="text-neutral-600 [&amp;>*]:relative [&amp;>:first-child]:before:absolute [&amp;>:first-child]:before:right-full [&amp;>:first-child]:before:content-['“'] [&amp;>:last-child]:after:content-['”']"
            >
              <p>
                Studio were so regular with their progress updates we almost
                began to think they were automated!
              </p>
            </blockquote>
            <figcaption class="mt-6 font-semibold text-neutral-950">
              Debra Fiscal, CEO of Unseal
            </figcaption>
          </figure>
        </div>
      </div>
    </div>

    <div class="mt-8 col-span-1 ">
      <h2 class="text-base/7 font-semibold text-zinc-950 sm:text-sm/6">
        Add Comment
      </h2>
      <div
        class="bg-gray-50 text-gray-100 w-full rounded-lg border border-gray-100 my-4 "
      >
        <div class="p-4">
          <label
            for="compose-mail"
            class="border-0 h-[1px] -m-[1px] overflow-hidden p-0 absolute whitespace-nowrap w-[1px]"
          >
            Your comment
          </label>
          <textarea
            id="compose-mail"
            rows="6"
            class="text-black px-0 bg-gray-50 w-full block outline-none border-0 py-0 text-sm focus:border-0 focus:outline-none focus:shadow-none"
            placeholder="Write a comment..."
          ></textarea>
        </div>
        <div class="p-4 border-t justify-between items-center flex">
          <button
            type="button"
            class="text-white font-semibold text-xs text-center py-3 px-3 bg-gray-700 hover:bg-gray-800 rounded-lg items-center inline-flex"
          >
            Post comment
          </button>
        </div>
      </div>
    </div>
  </div>
</div>